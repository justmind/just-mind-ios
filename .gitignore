# macOS
.DS_Store

# Xcode user-specific files
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/

# NOTE: JustMind.xcodeproj is generated by XcodeGen from project.yml, but it
# IS committed so Xcode Cloud (which builds from the git repo) can find it.
# After any `xcodegen generate`, commit the resulting project changes.
# User-specific data inside it stays ignored via the xcuserdata/ rule above.

# Swift Package Manager
.swiftpm/
.build/
Package.resolved

# Build outputs
*.ipa
*.dSYM.zip
*.dSYM

# Claude Code local settings (machine-specific)
.claude/

# Editor
*.swp
*.swo
.idea/
.vscode/

# CocoaPods (not used here, but conventional to ignore)
Pods/

# fastlane (not used, but conventional)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
